<%= turbo_stream_from Current.user, :transactions %>

<div class="flex min-h-dvh max-md:flex-col">
  <%= render "shared/sidebar" %>

  <main class="flex min-w-0 flex-1 flex-col gap-10 px-5 py-9 md:px-14">
    <h1 class="text-title">Settings</h1>

    <div class="flex max-w-[560px] flex-col gap-10">
      <section class="flex flex-col gap-4">
        <div class="flex items-baseline justify-between border-b border-secondary pb-3">
          <h2 class="text-heading">Appearance</h2>
        </div>

        <div class="flex items-center justify-between gap-6">
          <p class="text-md">Theme</p>
          <div class="flex w-[200px] gap-1 rounded-md bg-level-3 p-1">
            <%= button_to "Light", theme_path, method: :patch, params: { theme: "light" }, form: { class: "flex-1" }, data: { action: "click->theme#choose", theme: "light" }, class: "w-full cursor-pointer rounded-sm px-3 py-1.5 text-sm text-secondary in-data-[theme=light]:bg-level-2 in-data-[theme=light]:font-medium in-data-[theme=light]:text-primary in-data-[theme=light]:shadow-control" %>
            <%= button_to "Dark", theme_path, method: :patch, params: { theme: "dark" }, form: { class: "flex-1" }, data: { action: "click->theme#choose", theme: "dark" }, class: "w-full cursor-pointer rounded-sm px-3 py-1.5 text-sm text-secondary in-data-[theme=dark]:bg-level-2 in-data-[theme=dark]:font-medium in-data-[theme=dark]:text-primary in-data-[theme=dark]:shadow-control" %>
          </div>
        </div>
      </section>

      <%= turbo_frame_tag "bank_sync" do %>
        <% if content_for?(:bank_sync) %>
          <%= yield :bank_sync %>
        <% else %>
          <%= render "simplefin/accesses/section", access: Current.user.simplefin_access %>
        <% end %>
      <% end %>

      <section class="flex flex-col gap-4">
        <div class="flex items-baseline justify-between border-b border-secondary pb-3">
          <h2 class="text-heading">Your data</h2>
        </div>

        <div class="flex items-center justify-between gap-6">
          <div class="flex flex-col gap-1">
            <p class="text-md">Download every transaction</p>
            <p class="text-sm text-tertiary">A CSV file that opens in any spreadsheet app.</p>
          </div>
          <%= link_to "Download CSV", transactions_download_path(format: :csv), data: { turbo: false }, class: "outline-button" %>
        </div>
      </section>

      <section class="flex flex-col gap-4">
        <div class="flex items-baseline justify-between border-b border-secondary pb-3">
          <h2 class="text-heading">Account</h2>
        </div>

        <div class="flex items-center justify-between gap-6">
          <p class="text-md text-secondary">Signed in as <span class="font-medium text-primary"><%= Current.user.username %></span></p>
          <%= button_to "Sign out", session_path, method: :delete, class: "cursor-pointer rounded-sm px-2 py-1 text-sm font-medium text-secondary hover:bg-level-3 hover:text-primary" %>
        </div>
      </section>

      <section class="flex flex-col gap-4">
        <div class="flex items-baseline justify-between border-b border-secondary pb-3">
          <h2 class="text-heading">About</h2>
        </div>

        <div class="flex items-center justify-between gap-6">
          <p class="text-md">Version</p>
          <p class="text-md text-secondary"><%= Release.current_version %></p>
        </div>
      </section>
    </div>
  </main>
</div>
