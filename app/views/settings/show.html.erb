<%= turbo_stream_from Current.user, :transactions %>

<div class="flex min-h-dvh max-md:flex-col">
  <%= render "shared/sidebar" %>

  <main class="flex min-w-0 flex-1 flex-col gap-10 px-5 py-9 md:px-14">
    <h1 class="text-title">Settings</h1>

    <div class="grid max-w-[560px] gap-10 xl:max-w-none xl:grid-cols-2 xl:grid-rows-[repeat(5,auto)_1fr] xl:items-start xl:gap-x-16">
      <section class="flex flex-col gap-4 xl:col-start-1">
        <div class="flex items-baseline justify-between border-b border-secondary pb-3">
          <h2 class="text-heading">Appearance</h2>
        </div>

        <div class="flex items-center justify-between gap-6">
          <p class="text-md">Mode</p>
          <div class="flex w-[200px] gap-1 rounded-md bg-level-3 p-1">
            <%= button_to "Light", mode_path, method: :patch, params: { mode: "light" }, form: { class: "flex-1" }, data: { action: "click->theme#chooseMode", mode: "light" }, class: "w-full cursor-pointer rounded-sm px-3 py-1.5 text-sm text-secondary in-data-[mode=light]:bg-level-2 in-data-[mode=light]:text-primary in-data-[mode=light]:shadow-control" %>
            <%= button_to "Dark", mode_path, method: :patch, params: { mode: "dark" }, form: { class: "flex-1" }, data: { action: "click->theme#chooseMode", mode: "dark" }, class: "w-full cursor-pointer rounded-sm px-3 py-1.5 text-sm text-secondary in-data-[mode=dark]:bg-level-2 in-data-[mode=dark]:text-primary in-data-[mode=dark]:shadow-control" %>
          </div>
        </div>

        <div class="flex flex-col gap-3">
          <div class="flex flex-col gap-1">
            <p class="text-md">Theme</p>
            <p class="text-sm text-tertiary">Each one has a light and a dark side, so it follows the mode above.</p>
          </div>
          <div class="grid grid-cols-4 gap-2 sm:grid-cols-7">
            <% User::THEMES.each do |theme| %>
              <%= button_to theme_path, method: :patch, params: { theme: }, form: { class: "flex" }, data: { action: "click->theme#chooseTheme", theme: }, aria: { pressed: Current.user.theme == theme }, class: "group flex w-full cursor-pointer flex-col items-center gap-2 rounded-md p-1.5 text-sm text-secondary hover:bg-level-3 hover:text-primary aria-pressed:text-primary" do %>
                <span class="block aspect-square w-full rounded-sm border border-primary bg-linear-135 from-(--swatch-light) from-50% to-(--swatch-dark) to-50% shadow-control group-aria-pressed:outline-2 group-aria-pressed:outline-offset-2 group-aria-pressed:outline-(--text-color-primary)"></span>
                <%= theme.capitalize %>
              <% end %>
            <% end %>
          </div>
        </div>
      </section>

      <section class="flex flex-col gap-4 xl:col-start-1">
        <div class="flex items-baseline justify-between border-b border-secondary pb-3">
          <h2 class="text-heading">Keyboard</h2>
        </div>

        <div class="flex items-center justify-between gap-6">
          <div class="flex flex-col gap-1">
            <p class="text-md">Single-key shortcuts</p>
            <p class="text-sm text-tertiary">Press / to search transactions and ? to see every shortcut. Arrows always step months.</p>
          </div>
          <div class="flex w-[200px] shrink-0 gap-1 rounded-md bg-level-3 p-1">
            <%= button_to "On", shortcuts_path, method: :patch, params: { on: true }, form: { class: "flex-1" }, aria: { pressed: Current.user.single_key_shortcuts? }, class: "w-full cursor-pointer rounded-sm px-3 py-1.5 text-sm text-secondary aria-pressed:bg-level-2 aria-pressed:text-primary aria-pressed:shadow-control" %>
            <%= button_to "Off", shortcuts_path, method: :patch, params: { on: false }, form: { class: "flex-1" }, aria: { pressed: !Current.user.single_key_shortcuts? }, class: "w-full cursor-pointer rounded-sm px-3 py-1.5 text-sm text-secondary aria-pressed:bg-level-2 aria-pressed:text-primary aria-pressed:shadow-control" %>
          </div>
        </div>

        <div class="flex items-center justify-between gap-6 pointer-coarse:hidden">
          <div class="flex flex-col gap-1">
            <p class="text-md">All shortcuts</p>
            <p class="text-sm text-tertiary">Every key MoneyPouch knows, grouped by where you use it.</p>
          </div>
          <%= tag.button "Show shortcuts", type: :button, aria: { haspopup: "dialog", keyshortcuts: ("?" if Current.user.single_key_shortcuts?) },
            data: { controller: "dialog-opener", action: "dialog-opener#open", dialog_opener_id_param: "shortcuts" }, class: "outline-button" %>
        </div>
      </section>

      <%= turbo_frame_tag "bank_sync", class: "block xl:col-start-2 xl:row-span-6 xl:row-start-1" do %>
        <% if content_for?(:bank_sync) %>
          <%= yield :bank_sync %>
        <% else %>
          <%= render "simplefin/accesses/section", access: Current.user.simplefin_access %>
        <% end %>
      <% end %>

      <section class="flex flex-col gap-4 xl:col-start-1">
        <div class="flex items-baseline justify-between border-b border-secondary pb-3">
          <h2 class="text-heading">Your data</h2>
        </div>

        <div class="flex items-center justify-between gap-6">
          <div class="flex flex-col gap-1">
            <p class="text-md">Download every transaction</p>
            <p class="text-sm text-tertiary">A CSV file that opens in any spreadsheet app.</p>
          </div>
          <%= link_to "Download CSV", transactions_download_path(format: :csv), data: { turbo: false }, class: "outline-button" %>
        </div>
      </section>

      <section class="flex flex-col gap-4 xl:col-start-1">
        <div class="flex items-baseline justify-between border-b border-secondary pb-3">
          <h2 class="text-heading">Account</h2>
        </div>

        <div class="flex items-center justify-between gap-6">
          <p class="text-md text-secondary">Signed in as <span class="font-medium text-primary"><%= Current.user.username %></span></p>
          <%= button_to "Sign out", session_path, method: :delete, class: "header-button" %>
        </div>

        <% if Current.user.owner? %>
          <div class="flex items-center justify-between gap-6">
            <div class="flex flex-col gap-1">
              <p class="text-md">New accounts</p>
              <p class="text-sm text-tertiary"><%= Current.user.registration_open? ? "Anyone who can reach this server can create an account." : "Registration is closed. Only existing accounts can sign in." %></p>
            </div>
            <%= button_to Current.user.registration_open? ? "Close registration" : "Open registration", registration_path, method: :patch, params: { open: !Current.user.registration_open? }, class: "outline-button" %>
          </div>

          <% others = User.where.not(id: Current.user.id).order(:username) %>
          <% if others.any? %>
            <div class="flex flex-col gap-3">
              <div class="flex flex-col gap-1">
                <p class="text-md">Reset a password</p>
                <p class="text-sm text-tertiary">Make a link for someone locked out, then send it to them yourself.</p>
              </div>

              <% if flash[:reset_link] %>
                <div class="flex flex-col gap-2 rounded-md border border-primary bg-level-2 p-3" data-controller="clipboard">
                  <p class="text-sm text-secondary">Reset link for <span class="font-medium text-primary"><%= flash[:reset_username] %></span>. It works once and expires in 24 hours.</p>
                  <div class="flex items-center gap-2">
                    <%= text_field_tag :reset_link, flash[:reset_link], readonly: true, aria: { label: "Reset link" }, data: { clipboard_target: "source", action: "focus->clipboard#select" }, class: "h-9 min-w-0 flex-1 rounded-md border border-primary bg-level-1 px-3 text-sm" %>
                    <button type="button" data-clipboard-target="button" data-action="clipboard#copy" class="outline-button">Copy</button>
                  </div>
                </div>
              <% end %>

              <% others.each do |other| %>
                <div class="flex items-center justify-between gap-6">
                  <p class="text-md text-secondary"><%= other.username %></p>
                  <%= button_to "Reset link", user_password_reset_path(other), class: "outline-button" %>
                </div>
              <% end %>
            </div>
          <% end %>
        <% end %>
      </section>

      <section class="flex flex-col gap-4 xl:col-start-1">
        <div class="flex items-baseline justify-between border-b border-secondary pb-3">
          <h2 class="text-heading">About</h2>
        </div>

        <div class="flex items-center justify-between gap-6">
          <p class="text-md">Version</p>
          <p class="text-sm text-secondary"><%= Release.current_version %></p>
        </div>
      </section>
    </div>
  </main>
</div>
