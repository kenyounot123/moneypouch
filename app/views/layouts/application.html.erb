<!DOCTYPE html>
<html data-controller="theme time-zone" data-mode="<%= Current.user&.mode || "light" %>" data-theme="<%= Current.user&.theme || "pouch" %>" data-sidebar="<%= sidebar_state %>"
  <% if Current.user %><%= tag.attributes(data: { time_zone_saved_value: Current.user.time_zone, time_zone_url_value: time_zone_path }) %><% end %>>
  <head>
    <title><%= content_for(:title) || "Moneypouch" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Moneypouch">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= turbo_refreshes_with method: :morph, scroll: :preserve %>
    <%= yield :head %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="apple-touch-icon" href="/icon.png">

    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <%= yield %>
    <% unseen_releases = Current.user ? Current.user.unseen_releases : [] %>
    <% if unseen_releases.any? %>
      <%= render "shared/release_notes", releases: unseen_releases %>
    <% end %>
  </body>
</html>
