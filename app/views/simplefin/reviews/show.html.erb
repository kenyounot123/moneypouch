<% content_for :title, "From your bank" %>
<%= turbo_stream_from Current.user, :transactions %>

<div class="flex min-h-dvh max-md:flex-col">
  <%= render "shared/sidebar" %>

  <main class="flex min-w-0 flex-1 flex-col gap-10 px-5 py-9 md:px-14">
    <div class="flex flex-col gap-2">
      <%= render "shared/breadcrumbs", crumbs: [ [ "Overview", root_path ], [ "From your bank" ] ] %>
      <div class="flex flex-col items-start justify-between gap-4 sm:flex-row sm:items-center">
        <h1 class="text-title">From your bank</h1>

        <% if @review.completable? %>
          <div class="flex items-center gap-4">
            <p class="text-sm text-tertiary"><%= synced_ago Current.user.simplefin_access.last_synced_at %></p>
            <%= button_to "Done", simplefin_review_completion_path,
              class: "cursor-pointer rounded-md bg-action px-4 py-2 text-button text-on-action hover:brightness-95" %>
          </div>
        <% end %>
      </div>
    </div>

    <% if @review.pending? %>
      <div class="flex flex-col gap-14 lg:flex-row lg:items-start">
        <section class="flex min-w-0 flex-[1.3] flex-col gap-3">
          <nav class="flex flex-wrap gap-1 self-start rounded-[10px] bg-level-3 p-1" aria-label="Lists">
            <% Simplefin::Review::LISTS.each do |list| %>
              <%= link_to simplefin_review_path(show: list), aria: { current: list == @list ? "true" : nil },
                class: [ "flex shrink-0 items-baseline gap-2 rounded-sm px-3 py-1.5 text-sm whitespace-nowrap", list == @list ? "bg-level-2 font-medium text-primary shadow-control" : "text-secondary hover:text-primary" ] do %>
                <%= review_list_title list %>
                <span class="font-amount text-xs font-normal text-tertiary"><%= @review.transactions_in(list).count %></span>
              <% end %>
            <% end %>
          </nav>

          <ul class="flex flex-col border-t border-secondary" data-controller="category-picker" data-category-picker-categories-value="<%= picker_categories @categories %>">
            <%= render "simplefin/reviews/page", page: @page, list: @list %>
          </ul>
        </section>

        <%= render "simplefin/reviews/rules", rules: @rules %>
      </div>
    <% else %>
      <p class="text-secondary">Nothing new from your bank. <%= link_to "Back to Overview", root_path, class: "font-medium text-primary underline underline-offset-3" %></p>
    <% end %>
  </main>
</div>
