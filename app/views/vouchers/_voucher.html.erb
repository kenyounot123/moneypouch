<% shake = local_assigns.fetch(:shake, false) %>
<%= turbo_frame_tag "voucher", class: "block pr-5 pb-2 pl-[50px] in-[dialog]:-mt-2.5 in-[dialog]:pb-4" do %>
  <div class="flex flex-col in-[dialog]:gap-3" <%= tag.attributes(data: { composer_target: "row", shorthand: voucher.shorthand, completion: voucher.completion,
    inferred_category: (voucher.category_name if voucher.inferred?), marks: voucher_marks(voucher).to_json, calendar: voucher_calendar(voucher) }) %>>
    <% if voucher.shorthand.strip.present? %>
      <p class="hidden min-h-5 text-sm text-tertiary in-[dialog]:block">
        <%= safe_join [
          (tag.span("ok") if voucher.valid?),
          (tag.span(voucher.errors.to_sentence(two_words_connector: " · ", last_word_connector: " · "), class: "inline-block animate-shake text-danger") if shake && !voucher.valid?),
          (tag.span(money_flow(voucher.amount_in_cents), class: [ "font-amount", voucher.money_in? ? "text-success" : "text-secondary" ]) if voucher.amount_in_cents),
          tag.span(voucher.category&.new_record? ? "New category #{voucher.category_name}" : voucher.category_name || "Uncategorized", class: "text-secondary"),
          tag.span(relative_date(voucher.occurred_on), class: "text-secondary")
        ].compact, " · " %>
      </p>
    <% end %>
    <p class="hidden flex-wrap gap-x-5 gap-y-1 font-mono text-xs text-tertiary in-[dialog]:flex">
      <span class="whitespace-nowrap">format: <span class="text-primary">coffee</span> <span class="text-amount">5.50</span> <span class="text-date">@yesterday</span> <span class="text-category">#food</span></span>
      <span class="whitespace-nowrap">money in: <span class="text-primary">paycheck</span> <span class="text-success">+2400</span></span>
    </p>

    <div class="in-[dialog]:hidden">
      <%= render "vouchers/reading", label: "Name", read: voucher.name.present?, value: voucher_name_value(voucher),
        hint: "The place or the thing" %>
      <%= render "vouchers/reading", label: "Amount", read: voucher.amount_in_cents.present?, value: voucher_amount_value(voucher),
        hint: safe_join([ "For money in, start with a plus: ", example_tag("+2400", :money_in) ]) %>
      <%= render "vouchers/reading", label: "Date", read: false, value: voucher_date_value(voucher),
        hint: safe_join([ "For another day, add ", example_tag("yesterday", :date), " or ", example_tag("sep 26", :date) ]) %>
      <%= render "vouchers/reading", label: "Category", read: false, value: voucher_category_value(voucher),
        hint: safe_join([ "Add ", example_tag("#food", :category), " once. The same name gets it next time." ]) %>
      <% if shake && !voucher.valid? %>
        <p class="animate-shake border-t border-secondary pt-3 text-sm text-danger"><%= voucher.errors.to_sentence(two_words_connector: " · ", last_word_connector: " · ") %></p>
      <% end %>
    </div>
  </div>
<% end %>
