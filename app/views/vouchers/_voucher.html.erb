<% shake = local_assigns.fetch(:shake, false) %>
<%= turbo_frame_tag "voucher", class: "-mt-2.5 block pr-5 pb-4 pl-[50px]" do %>
  <div class="flex flex-col gap-3" <%= tag.attributes(data: { composer_target: "row", shorthand: voucher.shorthand, completion: voucher.completion,
    inferred_category: (voucher.category_name if voucher.inferred?), marks: voucher_marks(voucher).to_json, calendar: voucher_calendar(voucher) }) %>>
    <% if voucher.shorthand.strip.present? %>
      <p class="min-h-5 text-sm text-tertiary">
        <%= safe_join [
          (tag.span("ok") if voucher.valid?),
          (tag.span(voucher.errors.to_sentence(two_words_connector: " · ", last_word_connector: " · "), class: "inline-block animate-shake text-danger") if shake && !voucher.valid?),
          (tag.span(money_flow(voucher.amount_in_cents), class: [ "font-amount", voucher.money_in? ? "text-success" : "text-secondary" ]) if voucher.amount_in_cents),
          tag.span(voucher.category&.new_record? ? "New category #{voucher.category_name}" : voucher.category_name || "Uncategorized", class: "text-secondary"),
          tag.span(relative_date(voucher.occurred_on), class: "text-secondary")
        ].compact, " · " %>
      </p>
    <% end %>
    <p class="flex flex-wrap gap-x-5 gap-y-1 font-mono text-xs text-tertiary">
      <span class="whitespace-nowrap">format: <span class="text-primary">coffee</span> <span class="text-amount">5.50</span> <span class="text-date">@yesterday</span> <span class="text-category">#food</span></span>
      <span class="whitespace-nowrap">money in: <span class="text-primary">paycheck</span> <span class="text-success">+2400</span></span>
    </p>
  </div>
<% end %>
