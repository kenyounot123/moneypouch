<div class="w-full pl-5" data-controller="dismiss">
  <div class="flex flex-col gap-2 rounded-md border border-secondary bg-level-1 pt-3 pr-3 pb-2.5 pl-3.5">
    <p class="text-sm leading-5 text-secondary">
      <% if transaction.transfer? %>
        Always mark transactions named <span class="font-semibold text-primary">“<%= transaction.name %>”</span> as <%= categorization_chip transaction.categorization %>?
      <% else %>
        Always put transactions named <span class="font-semibold text-primary">“<%= transaction.name %>”</span> in the <%= categorization_chip transaction.categorization %> category?
      <% end %>
    </p>
    <div class="flex flex-wrap items-center justify-end gap-x-3 gap-y-2">
      <p class="min-w-56 flex-1 text-xs text-tertiary"><%= rule_reach transaction %></p>
      <button type="button" class="<%= SimplefinHelper::HEADER_BUTTON %> shrink-0" data-action="dismiss#dismiss">Just this one</button>
      <%= button_to "Make a rule", transaction_rule_path(transaction), form: { class: "shrink-0", data: { turbo_frame: "_top" } },
        class: "cursor-pointer rounded-sm bg-action px-3 py-1.5 font-pixel text-sm font-semibold tracking-pixel whitespace-nowrap text-on-action hover:brightness-95" %>
    </div>
  </div>
</div>
