<% offering_rule = offering_rule?(transaction) %>
<li id="<%= dom_id transaction %>" class="group border-b border-secondary last:border-b-0 <%= "pb-3" if offering_rule %>">
  <div class="transaction-row relative">
    <%= link_to "", edit_transaction_path(transaction), aria: { label: transaction.name }, data: { turbo_frame: "sheet" }, class: "absolute inset-0 @xl:hidden" %>

    <div class="flex justify-center [grid-area:dot]">
      <% if transaction.needs_category? %>
        <%= row_marker "Needs a category" %>
      <% end %>
    </div>

    <div class="flex min-w-0 items-center gap-2.5 [grid-area:name]" data-controller="note" data-note-url-value="<%= transaction_note_path(transaction) %>">
      <div class="flex min-w-0 flex-col gap-0.5 @xl:flex-row @xl:items-baseline @xl:gap-2.5" data-note-target="name">
        <p data-field="name" class="truncate font-medium <%= transaction.excluded? ? "@xl:min-w-0" : "@xl:max-w-full @xl:shrink-0" %> <%= "text-tertiary" unless transaction.counted? %>"><%= pivot_label transaction.name, Transaction::Query.text_token(transaction.name), title: "Show all #{transaction.name}", pivot: local_assigns[:pivot] %></p>
        <% if transaction.excluded? %>
          <%= excluded_tag class: "hidden @xl:inline" %>
        <% end %>
        <% if transaction.note %>
          <button type="button" class="flex min-w-0 cursor-text items-center gap-1.5 text-left text-secondary @xl:block @xl:truncate @xl:text-sm @xl:text-tertiary @xl:hover:text-secondary"
            data-note-target="label" data-action="note#open" data-note-text-param="<%= transaction.note %>"><%= icon_tag("note", class: "size-3 text-tertiary @xl:hidden") %><span class="truncate"><%= transaction.note %></span></button>
        <% end %>
      </div>
      <div role="group" aria-label="Actions" class="ml-auto hidden shrink-0 items-center gap-0.5 bg-level-0 @xl:group-focus-within:flex @xl:group-hover:flex">
        <% if transaction.note.nil? %>
          <button type="button" aria-label="Add a note" title="Add a note" class="flex icon-button"
            data-note-target="label" data-action="note#open"><%= icon_tag "note" %></button>
        <% end %>
        <%= exclusion_button transaction, icon: true %>
        <%= icon_button_to "Delete", :delete, transaction, method: :delete, data: { turbo_confirm: "Delete #{transaction.name}?" } %>
      </div>
    </div>

    <div class="flex min-w-0 items-center gap-1 text-sm text-tertiary [grid-area:meta] @xl:contents">
      <%= render "transactions/row_category", transaction: %>
      <% if transaction.excluded? %>
        <span class="shrink-0 @xl:hidden">· Excluded</span>
      <% end %>
      <% if transaction.from_bank? %>
        <span class="truncate @xl:hidden @4xl:block @4xl:[grid-area:account]"><span class="@xl:hidden">· </span><span data-field="account"><%= pivot_label transaction.bank_account_name, Transaction::Query.account_token(transaction.bank_transaction.bank_account), title: "Show all in #{transaction.bank_account_name}", pivot: local_assigns[:pivot] %></span></span>
      <% end %>
    </div>

    <p class="text-right font-amount [grid-area:amount] <%= amount_color transaction %>"><%= money_flow transaction.amount_in_cents %></p>
  </div>

  <% if offering_rule %>
    <%= render "transactions/rule_offer", transaction:, indent: "pl-5 @xl:pl-6" %>
  <% end %>
</li>
