<% content_for :title, "Transactions" %>
<%= turbo_stream_from Current.user, :transactions %>

<div class="flex min-h-dvh max-md:flex-col">
  <%= render "shared/sidebar" %>

  <main class="@container flex min-w-0 flex-1 flex-col gap-7 px-5 py-9 md:px-14"
    <%= tag.attributes data: { controller: "search", search_categories_value: search_categories(@categories, @category_counts), search_accounts_value: search_accounts(@bank_accounts),
      search_suggestions_url_value: transactions_suggestions_path, search_today_value: Date.current.iso8601 } %>>
    <button type="button" aria-label="Back to top" data-controller="back-to-top" data-action="scroll@window->back-to-top#toggle:passive back-to-top#scroll"
      class="invisible sticky bottom-6 z-20 order-last flex size-9 cursor-pointer items-center justify-center self-end rounded-full border border-primary bg-level-2 text-secondary opacity-0 shadow-control transition-[opacity,visibility] hover:border-(--ring-color-focus) hover:text-primary data-shown:visible data-shown:opacity-100 md:bottom-8">
      <%= icon_tag "arrow-up" %>
    </button>

    <% if @import %>
      <%= render layout: "shared/toast", locals: { id: dom_id(@import, :toast) } do %>
        <span class="min-w-0 text-sm wrap-break-word">Imported <span class="font-medium"><%= imported_transactions @import %></span> from <%= @import.filename %></span>
        <%= button_to "Undo", import_path(@import), method: :delete, form: { class: "shrink-0", data: { turbo_confirm: undo_import_question(@import) } },
          class: "cursor-pointer rounded-sm px-2 py-1 text-sm font-medium whitespace-nowrap text-secondary hover:bg-level-3 hover:text-primary" %>
      <% end %>
    <% end %>

    <%= render "transactions/months", query: @query, month: @month, this_month: @this_month, short: true, visibility: "flex md:hidden" %>

    <div class="flex flex-wrap items-end justify-between gap-6">
      <div class="flex min-w-0 flex-col gap-2.5 @xl:flex-row @xl:items-end @xl:gap-12">
        <div class="flex flex-col gap-2.5">
          <p class="text-secondary"><%= @query.filtering? && !@query.month ? "Spent across matches" : "Spent in #{month_name @month}" %></p>
          <p class="text-display" data-field="spent"><%= money @listing.spent %></p>
        </div>
        <dl class="hidden gap-8 pb-1.5 @xl:flex">
          <% { "Income" => [ money(@listing.income) ], "Net" => [ signed_money(@listing.net), money_color(@listing.net) ], "Transactions" => [ number_with_delimiter(@listing.count) ] }.each do |term, (value, color)| %>
            <div class="flex flex-col gap-1">
              <dt class="text-sm text-tertiary"><%= term %></dt>
              <dd class="font-amount text-md <%= color %>"><%= value %></dd>
            </div>
          <% end %>
        </dl>
        <p class="text-sm text-tertiary @xl:hidden">Income <%= money @listing.income %> · Net <%= tag.span signed_money(@listing.net), class: money_color(@listing.net) %> · <%= pluralize @listing.count, "transaction" %></p>
      </div>

      <%= render "transactions/months", query: @query, month: @month, this_month: @this_month, short: false, visibility: "hidden md:flex" %>
    </div>

    <%= render "transactions/search", query: @query, month: @month, listing: @listing %>

    <div class="flex flex-col" data-controller="category-picker" data-category-picker-categories-value="<%= picker_categories @categories %>">
      <% if @listing.count.positive? %>
        <div class="hidden items-center gap-4 border-b border-primary pb-2 text-xs text-tertiary @xl:flex" aria-hidden="true">
          <p class="w-24 shrink-0">Date</p>
          <p class="w-2 shrink-0"></p>
          <p class="min-w-0 flex-1">Name</p>
          <p class="w-37.5 shrink-0">Category</p>
          <p class="hidden w-47.5 shrink-0 @4xl:block">Account</p>
          <p class="w-25 shrink-0 text-right">Amount</p>
        </div>

        <%= turbo_frame_tag [ :days, @listing.page.before ].compact.join("_"), target: "_top" do %>
          <% @listing.transactions.group_by(&:occurred_on).each do |date, transactions| %>
            <%= render "transactions/day", date:, transactions:, total: @listing.day_totals[date], pivot: true %>
          <% end %>

          <% if @listing.page.next_before %>
            <%= turbo_frame_tag :days, @listing.page.next_before, src: transactions_path(q: @query.to_s.presence, month: month_param(@month), before: @listing.page.next_before),
              loading: :lazy, refresh: :morph, target: "_top" %>
          <% end %>
        <% end %>
      <% elsif @query.parts.any? %>
        <p class="flex flex-wrap items-center gap-x-3 gap-y-2 text-sm text-tertiary">
          <span>No transactions match.</span>
          <% if @query.month %>
            <%= link_to "Search all months", search_path(@query.without_dates, @month), class: "rounded-full bg-level-3 px-3 py-1 text-sm font-medium text-secondary hover:text-primary" %>
          <% end %>
        </p>
      <% else %>
        <p class="text-sm text-tertiary">Nothing in <%= month_name @month %>.</p>
      <% end %>
    </div>

    <dialog aria-label="Transaction" data-controller="sheet"
      data-action="turbo:frame-load->sheet#open click->sheet#dismiss turbo:submit-start->sheet#close turbo:before-morph-attribute->sheet#keepClosed close->sheet#forget"
      class="m-0 mt-auto max-h-[85dvh] w-full max-w-none overflow-y-auto rounded-t-[16px] border-0 bg-level-2 p-0 text-primary backdrop:bg-scrim">
      <%= turbo_frame_tag "sheet", data: { sheet_target: "frame" } %>
    </dialog>
  </main>
</div>
