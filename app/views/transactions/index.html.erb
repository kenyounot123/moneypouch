<% content_for :title, "Transactions" %>

<div class="w-full">
  <% if notice.present? %>
    <p class="py-2 px-3 bg-(--text-color-success)/10 mb-5 text-success font-medium rounded-md inline-block" id="notice"><%= notice %></p>
  <% end %>

  <div class="flex justify-between items-center">
    <h1 class="text-title">Transactions</h1>
  </div>

  <% if @transactions.any? %>
    <ul id="transactions" class="flex flex-col gap-1" data-controller="category-picker" data-category-picker-categories-value="<%= @category_names.to_json %>">
      <%= render @transactions, deletable: true %>
    </ul>
  <% else %>
    <p class="text-center my-10">No transactions yet.</p>
  <% end %>
</div>
