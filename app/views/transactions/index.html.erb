<% content_for :title, "Transactions" %>

<div class="w-full">
  <% if notice.present? %>
    <p class="py-2 px-3 bg-green-50 mb-5 text-green-500 font-medium rounded-md inline-block" id="notice"><%= notice %></p>
  <% end %>

  <div class="flex justify-between items-center">
    <h1 class="text-title">Transactions</h1>
  </div>

  <% if @transactions.any? %>
    <ul id="transactions" class="flex flex-col gap-1" data-controller="category-picker" data-category-picker-categories-value="<%= @category_names.to_json %>">
      <% @transactions.each do |transaction| %>
        <%= render transaction do %>
          <%= button_to "Delete", transaction, method: :delete, class: "rounded-md px-3.5 py-2.5 text-white bg-red-600 hover:bg-red-500 font-medium cursor-pointer", data: { turbo_confirm: "Delete this transaction?" } %>
        <% end %>
      <% end %>
    </ul>
  <% else %>
    <p class="text-center my-10">No transactions yet.</p>
  <% end %>
</div>
