<% field = local_assigns[:field] && transaction.needs_category? %>
<% offering_rule = local_assigns.fetch(:review_rows, []).exclude?(transaction) && offering_rule?(transaction) %>
<li id="<%= dom_id transaction %>" class="group relative flex items-center gap-3 border-b border-secondary py-3 last:border-b-0 <%= "flex-wrap" if offering_rule %>">
  <div class="flex w-2 shrink-0 justify-center">
    <% if transaction == local_assigns[:added] || transaction.needs_category? %>
      <div class="size-1.5 rounded-[1px] bg-highlight"></div>
    <% end %>
  </div>
  <div class="flex min-w-0 flex-1 flex-col <%= field ? "gap-1" : "gap-0.5" %>" data-controller="note" data-note-url-value="<%= transaction_note_path(transaction) %>">
    <div class="flex min-w-0 items-center gap-2.5" data-note-target="name">
      <p class="truncate font-medium <%= "text-tertiary" if transaction.transfer? %>"><%= transaction.name %></p>
      <% if transaction.note.nil? %>
        <button type="button" class="hidden shrink-0 cursor-pointer items-center gap-1 rounded-[4px] bg-level-3 px-1.5 py-px text-xs text-tertiary group-focus-within:flex group-hover:flex hover:text-secondary"
          data-note-target="label" data-action="note#open"><%= pencil_icon %>Add a note</button>
      <% end %>
    </div>
    <% if transaction.note %>
      <button type="button" class="flex max-w-full cursor-text items-center gap-1.5 self-start text-left text-base text-secondary hover:text-primary"
        data-note-target="label" data-action="note#open" data-note-text-param="<%= transaction.note %>"><%= pencil_icon %><span class="truncate"><%= transaction.note %></span></button>
    <% end %>
    <div class="flex min-w-0 items-center gap-1 text-sm text-tertiary">
      <% if field %>
        <span class="<%= TransactionsHelper::CATEGORY_FIELD_SLOT %>" data-category-picker-target="category"><%= render "transactions/category_button", transaction:, label: "Category",
          class: TransactionsHelper::CATEGORY_FIELD %></span>
        <span class="shrink-0 pl-0.5 whitespace-nowrap">· <%= short_date transaction.occurred_on %></span>
      <% else %>
        <span class="flex h-4 items-center [&_input]:h-6" data-category-picker-target="category"><%= render "transactions/category_button", transaction:, label: categorization_label(transaction),
          class: TransactionsHelper::CATEGORY_LINK %></span>
        <span class="whitespace-nowrap">· <%= short_date transaction.occurred_on %></span>
      <% end %>
      <% if local_assigns[:account] %>
        <span class="truncate">· <%= transaction.bank_account_name %></span>
      <% end %>
    </div>
  </div>
  <p class="w-[90px] shrink-0 text-right font-mono <%= "text-tertiary" if transaction.transfer? %>"><%= money transaction.amount_in_cents %></p>
  <div class="flex w-4 shrink-0 justify-center text-tertiary">
    <% if transaction.transfer? %>
      <%= transfer_icon %>
      <span class="sr-only">Transfer, not spending</span>
    <% elsif transaction.from_bank? %>
      <svg width="14" height="14" viewBox="0 0 14 14" aria-hidden="true"><path d="M2 5.5L7 2.5l5 3M2.5 5.5v5.5M11.5 5.5v5.5M1.5 11.5h11M5 7v3M9 7v3" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round" /></svg>
      <span class="sr-only">From your bank</span>
    <% end %>
  </div>
  <% if offering_rule %>
    <%= render "transactions/rule_offer", transaction: %>
  <% end %>
</li>
