<% active = usage.active?(category) %>
<% total = usage.total(category) %>
<% months = usage.months(category) %>
<% peak = months.values.max %>
<li id="<%= dom_id category %>" class="category-columns relative min-h-12 rounded-sm border-b border-secondary px-2 py-2 hover:bg-level-1">
  <p class="flex min-w-0 items-baseline gap-2.5">
    <%= link_to category.name, category_path(category, span_params(usage.span)), class: class_names("truncate text-md font-medium after:absolute after:inset-0", "text-tertiary": !active) %>
    <% if category.default_income? %>
      <span class="text-xs text-tertiary" title="Money in with no other category lands in <%= category.name %>, so it keeps its name">Default</span>
    <% end %>
  </p>

  <div class="grid h-5 grid-cols-12 items-end gap-0.5 max-md:hidden" aria-hidden="true">
    <% months.each do |month, cents| %>
      <div class="<%= class_names "rounded-[1px]", month_bar_color(usage.span, month, cents) %>" style="height: <%= [ month_bar_height(cents, peak, CategoriesHelper::SPARK_HEIGHT), 1 ].max %>px" title="<%= month_title month %> · <%= money cents %>"></div>
    <% end %>
  </div>

  <% shared = active && total.positive? && section_total.positive? %>
  <div class="flex items-center gap-2 max-md:hidden" title="<%= "#{share_of total, section_total} of #{category_kind(category).downcase}" if shared %>">
    <div class="h-1.5 flex-1 rounded-bar bg-data-track" aria-hidden="true">
      <% if shared %>
        <div class="h-full rounded-bar bg-data" style="width: max(2px, <%= (total * 100.0 / section_total).round(1) %>%)"></div>
      <% end %>
    </div>
    <span class="w-8 shrink-0 text-right font-amount text-xs text-tertiary" data-field="share"><%= share_of total, section_total if shared %></span>
  </div>

  <p class="text-right font-amount <%= "text-tertiary" unless active %>" data-field="total"><%= active ? money(total) : "—" %></p>

  <% if category.default_income? %>
    <span></span>
  <% else %>
    <%= render "categories/manage", category:, categories:, usage:, anchor: "--#{dom_id category}" %>
  <% end %>
</li>
