<% content_for :title, @category.name %>
<%= turbo_stream_from Current.user, :transactions %>
<% span = @usage.span %>
<% kind = category_kind @category %>

<div class="flex min-h-dvh max-md:flex-col">
  <%= render "shared/sidebar" %>

  <main class="@container flex min-w-0 flex-1 flex-col gap-7 px-5 py-9 md:px-14">
    <div class="flex flex-col gap-2">
      <%= link_to "‹ Categories", categories_path(span_params(span)), class: "self-start text-sm text-tertiary hover:text-primary" %>
      <div class="flex items-center gap-2">
        <h1 class="text-title"><%= @category.name %></h1>
        <% unless @category.default_income? %>
          <%= render "categories/manage", category: @category, categories: @categories, usage: @usage, anchor: "--manage" %>
        <% end %>
      </div>
    </div>

    <% if alert %>
      <p id="alert" role="alert" class="text-sm text-danger"><%= alert %></p>
    <% end %>

    <%= render "categories/spans", span:, category: @category %>

    <div class="flex flex-wrap gap-x-12 gap-y-6">
      <div class="flex flex-col gap-1.5">
        <p class="text-secondary"><%= kind %> <%= span_phrase span %></p>
        <p class="text-display" data-field="total"><%= @usage.active?(@category) ? money(@usage.total(@category)) : "—" %></p>
        <% if @usage.refunded(@category).positive? %>
          <p class="text-sm text-tertiary" data-field="refunded">After <%= money @usage.refunded(@category) %> in refunds</p>
        <% end %>
      </div>
      <div class="flex flex-col gap-1.5">
        <p class="text-secondary">Monthly average</p>
        <p class="font-amount text-lg" data-field="average"><%= money @usage.monthly_average(@category) %></p>
        <p class="text-sm text-tertiary">Last 12 months</p>
      </div>
      <div class="flex flex-col gap-1.5">
        <p class="text-secondary">Last transaction</p>
        <p class="text-lg" data-field="last-transaction"><%= @usage.last_on(@category) ? short_date(@usage.last_on(@category)) : "None yet" %></p>
      </div>
    </div>

    <% months = @usage.months(@category) %>
    <% peak = months.values.max %>
    <nav class="flex gap-1.5" aria-label="<%= kind %> by month">
      <% months.each do |month, cents| %>
        <% chosen = span.cover?(month) %>
        <%= link_to category_path(@category, month: month_param(month)), aria: { label: "#{month_title month}: #{money cents}", current: (chosen && span.one_month?) ? "true" : nil },
          title: "#{month_title month} · #{money cents}",
          class: "group flex min-w-0 flex-1 flex-col items-center gap-1.5 rounded-sm pt-1.5 pb-1 hover:bg-level-3" do %>
          <div class="flex h-[120px] w-full items-end justify-center px-1">
            <div class="<%= class_names "w-full max-w-10 rounded-t-bar", month_bar_color(span, month, cents) %>" style="height: <%= [ month_bar_height(cents, peak), 2 ].max %>px"></div>
          </div>
          <span class="<%= class_names "text-xs", chosen ? "font-medium text-primary" : "text-tertiary group-hover:text-primary" %>"><%= month_abbreviation month %></span>
        <% end %>
      <% end %>
    </nav>

    <div class="flex flex-col" data-controller="category-picker" data-category-picker-categories-value="<%= picker_categories @categories %>">
      <% if @listing.count.positive? %>
        <div class="hidden items-center gap-4 border-b border-primary pb-2 text-xs text-tertiary @xl:flex" aria-hidden="true">
          <p class="w-24 shrink-0">Date</p>
          <p class="w-2 shrink-0"></p>
          <p class="min-w-0 flex-1">Name</p>
          <p class="w-37.5 shrink-0">Category</p>
          <p class="hidden w-47.5 shrink-0 @4xl:block">Account</p>
          <p class="w-25 shrink-0 text-right">Amount</p>
        </div>

        <%= turbo_frame_tag [ :days, @listing.page.before ].compact.join("_"), target: "_top" do %>
          <% @listing.transactions.group_by(&:occurred_on).each do |date, transactions| %>
            <%= render "transactions/day", date:, transactions:, total: @listing.day_totals[date] %>
          <% end %>

          <% if @listing.page.next_before %>
            <%= turbo_frame_tag :days, @listing.page.next_before, src: category_path(@category, **span_params(span), before: @listing.page.next_before),
              loading: :lazy, refresh: :morph, target: "_top" %>
          <% end %>
        <% end %>
      <% else %>
        <p class="flex flex-wrap items-center gap-x-3 gap-y-2 text-sm text-tertiary" data-field="empty">
          <span>No transactions <%= span_phrase span %>.<% if (last_on = @usage.last_on(@category)) %> The last one was on <%= short_date last_on %>.<% end %></span>
          <% if last_on && !span.range.cover?(last_on) %>
            <%= link_to "Show #{last_on.strftime("%B %Y")}", category_path(@category, month: last_on.strftime("%Y-%m")),
              class: "rounded-full bg-level-3 px-3 py-1 text-sm font-medium text-secondary hover:text-primary" %>
          <% end %>
        </p>
      <% end %>
    </div>

    <dialog aria-label="Transaction" data-controller="sheet"
      data-action="turbo:frame-load->sheet#open click->sheet#dismiss turbo:submit-start->sheet#close turbo:before-morph-attribute->sheet#keepClosed close->sheet#forget"
      class="m-0 mt-auto max-h-[85dvh] w-full max-w-none overflow-y-auto rounded-t-[16px] border-0 bg-level-2 p-0 text-primary backdrop:bg-scrim">
      <%= turbo_frame_tag "sheet", data: { sheet_target: "frame" } %>
    </dialog>
  </main>
</div>
