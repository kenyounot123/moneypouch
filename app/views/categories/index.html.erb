<% content_for :title, "Categories" %>
<%= turbo_stream_from Current.user, :transactions %>

<div class="flex min-h-dvh max-md:flex-col">
  <%= render "shared/sidebar" %>

  <main class="flex min-w-0 flex-1 flex-col gap-10 px-5 py-9 md:px-14">
    <div class="flex flex-col gap-2">
      <h1 class="text-title">Categories</h1>
      <p class="text-sm text-tertiary">Add one from the composer with a hashtag, like <span class="font-mono">Chipotle 11.25 #food</span>.</p>
    </div>

    <% if alert %>
      <p id="alert" role="alert" class="text-sm text-danger"><%= alert %></p>
    <% end %>

    <div class="flex max-w-[860px] flex-col gap-10">
      <% [ [ "Spending", @categories.reject(&:income?) ], [ "Income", @categories.select(&:income?) ] ].each do |heading, group| %>
        <section class="flex flex-col" aria-labelledby="<%= heading.downcase %>_heading">
          <div class="flex items-baseline justify-between border-b border-secondary pb-3">
            <h2 id="<%= heading.downcase %>_heading" class="text-heading"><%= heading %></h2>
            <p class="text-sm text-tertiary"><%= month_name @usage.period %></p>
          </div>

          <ul class="flex flex-col">
            <%= render partial: "categories/category", collection: group, locals: { categories: @categories, usage: @usage } %>
            <% if group.empty? %>
              <li class="py-3 text-sm text-tertiary">No <%= heading.downcase %> categories yet.</li>
            <% end %>
          </ul>
        </section>
      <% end %>
    </div>
  </main>
</div>
