<% content_for :title, "Categories" %>
<%= turbo_stream_from Current.user, :transactions %>

<div class="flex min-h-dvh max-md:flex-col">
  <%= render "shared/sidebar" %>

  <main class="flex min-w-0 flex-1 flex-col gap-10 px-5 py-9 md:px-14">
    <div class="flex flex-col gap-2">
      <h1 class="text-title">Categories</h1>
      <p class="text-sm text-tertiary">Every category your transactions are filed under. Rename, merge, or delete one here, or open it to see its transactions.</p>
    </div>

    <% if alert %>
      <p id="alert" role="alert" class="text-sm text-danger"><%= alert %></p>
    <% end %>

    <section class="flex max-w-[860px] flex-col" aria-label="Categories">
      <div class="flex items-baseline justify-end border-b border-secondary pb-3">
        <p class="text-sm text-tertiary"><%= month_name @usage.period %></p>
      </div>

      <ul class="flex flex-col">
        <%= render partial: "categories/category", collection: @categories, locals: { categories: @categories, usage: @usage } %>
      </ul>
    </section>
  </main>
</div>
