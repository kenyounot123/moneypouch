<% menu_id = dom_id(category, :manage) %>
<button type="button" popovertarget="<%= menu_id %>" aria-label="Manage <%= category.name %>" title="Manage <%= category.name %>"
  class="relative z-10 flex icon-button" style="anchor-name: <%= anchor %>">
  <%= icon_tag "more" %>
</button>

<div id="<%= menu_id %>" popover class="anchored-menu" style="position-anchor: <%= anchor %>">
  <%= form_with model: category, method: :patch, class: "flex flex-col gap-1.5" do |form| %>
    <%= form.label :name, "Rename", for: dom_id(category, :name), class: "text-xs text-tertiary" %>
    <div class="flex gap-2">
      <%= form.text_field :name, id: dom_id(category, :name), autocomplete: "off", required: true,
        class: "h-8 min-w-0 flex-1 rounded-sm border border-primary bg-level-2 px-2 text-sm outline-none focus:border-(--ring-color-focus)" %>
      <%= form.submit "Save", class: "cursor-pointer rounded-sm bg-level-3 px-3 text-sm font-medium text-secondary hover:text-primary" %>
    </div>
  <% end %>

  <% others = categories.reject { |other| other == category } %>
  <% if others.any? %>
    <%= form_with url: category_merge_path(category), method: :post, data: { turbo_confirm: merge_category_question(category, usage) }, class: "flex flex-col gap-1.5" do %>
      <%= label_tag dom_id(category, :into), "Merge into", class: "text-xs text-tertiary" %>
      <%= select_tag :into, options_from_collection_for_select(others, :id, :name), id: dom_id(category, :into), prompt: "Pick a category", required: true,
        data: { controller: "auto-submit", action: "change->auto-submit#submit" },
        class: "h-8 cursor-pointer rounded-sm border border-primary bg-level-2 px-2 text-sm" %>
    <% end %>
  <% end %>

  <%= button_to category_path(category), method: :delete, aria: { label: "Delete #{category.name}" }, data: { turbo_confirm: delete_category_question(category, usage) },
    form: { class: "flex border-t border-secondary pt-3" },
    class: "flex cursor-pointer items-center gap-1.5 text-sm font-medium text-danger hover:underline" do %>
    <%= icon_tag "delete" %>Delete
  <% end %>
</div>
