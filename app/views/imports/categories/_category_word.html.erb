<div class="flex flex-col gap-2 border-t border-secondary py-3">
  <div class="flex items-center gap-3">
    <div class="flex min-w-0 flex-1 flex-col gap-0.5">
      <p class="truncate text-md font-medium"><%= category_word.word %></p>
      <p class="truncate text-sm text-tertiary"><%= pluralize number_with_delimiter(category_word.count), "row" %></p>
    </div>
    <%= hidden_field_tag "import[categories][][word]", category_word.word, id: nil %>
    <%= render "imports/categories/select", name: "import[categories][][name]", choices: category_choices(category_word, category_names),
      selected: category_word.name, label: "What #{category_word.word} becomes" %>
  </div>
  <% if category_word.money_in_choice? %>
    <div class="flex items-center gap-3">
      <p class="min-w-0 flex-1 truncate pl-4 text-sm text-tertiary"><span aria-hidden="true">└</span> <%= money_in_sentence category_word %></p>
      <%= render "imports/categories/select", name: "import[categories][][money_in]", choices: money_in_choices(category_word, income_names),
        selected: category_word.money_in_name.to_s, label: "What #{category_word.word} money in becomes" %>
    </div>
  <% end %>
</div>
