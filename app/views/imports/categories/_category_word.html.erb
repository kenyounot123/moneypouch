<div class="flex items-center gap-3 border-t border-secondary py-3">
  <div class="flex min-w-0 flex-1 flex-col gap-0.5">
    <p class="truncate text-md font-medium"><%= category_word.word %></p>
    <p class="truncate text-sm text-tertiary"><%= pluralize number_with_delimiter(category_word.count), "row" %></p>
  </div>
  <%= hidden_field_tag "import[categories][][word]", category_word.word, id: nil %>
  <span class="relative flex w-[200px] max-w-[50%] shrink-0">
    <%= select_tag "import[categories][][name]", options_for_select(category_choices(category_word, category_names), category_word.name), id: nil,
      aria: { label: "What #{category_word.word} becomes" }, onchange: "this.form.requestSubmit()",
      class: "h-8.5 w-full min-w-0 cursor-pointer appearance-none rounded-lg border border-primary bg-level-0 pr-7 pl-3 text-sm text-primary hover:border-(--ring-color-focus)" %>
    <span class="pointer-events-none absolute top-1/2 right-3 -translate-y-1/2 text-sm text-tertiary" aria-hidden="true">▾</span>
  </span>
</div>
