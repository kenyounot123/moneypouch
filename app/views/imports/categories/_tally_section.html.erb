<%# locals: (title:, detail:, lines:, more: 0, amount: nil, detail_class: "text-tertiary", amount_class: nil) %>
<section aria-label="<%= title %>" class="flex flex-col gap-2 border-t border-secondary py-3">
  <div class="flex items-center justify-between gap-3">
    <div class="flex min-w-0 flex-col gap-0.5">
      <p class="truncate text-md font-medium"><%= title %></p>
      <p class="truncate text-sm <%= detail_class %>"><%= detail %></p>
    </div>
    <% if amount %>
      <p class="font-amount shrink-0 text-md whitespace-nowrap <%= amount_class %>"><%= amount %></p>
    <% end %>
  </div>
  <ul class="flex flex-col gap-2">
    <% lines.each do |line_label, line_amount| %>
      <li class="flex items-baseline gap-3 pl-4 text-sm text-tertiary">
        <p class="flex min-w-0 flex-1 gap-1">
          <span aria-hidden="true">└</span>
          <span class="min-w-0 break-words"><%= line_label %></span>
        </p>
        <% if line_amount %>
          <p class="font-amount shrink-0 whitespace-nowrap"><%= line_amount %></p>
        <% end %>
      </li>
    <% end %>
  </ul>
  <% if more.positive? %>
    <p class="pl-4 text-sm text-tertiary">And <%= number_with_delimiter more %> more.</p>
  <% end %>
</section>
