<div class="flex min-h-dvh flex-col items-center justify-center gap-9 bg-level-0 px-4 py-10">
  <div class="flex flex-col items-center gap-2 text-center">
    <h1 class="text-title">What did you last spend on?</h1>
    <p class="text-secondary">Type it on one line. A name and an amount are enough.</p>
  </div>

  <div class="w-[640px] max-w-full">
    <%= render "shared/composer", voucher: @voucher, category_names: @category_names %>
  </div>

  <div class="flex flex-col items-center gap-3 text-sm sm:flex-row sm:gap-4">
    <% unless demo? %>
      <div class="flex flex-col items-center gap-1.5 sm:flex-row sm:gap-4">
        <p class="text-tertiary">Already have a history?</p>
        <div class="flex items-center gap-4">
          <%= link_to "Import a file", new_import_path, class: "font-medium text-secondary hover:text-primary" %>
          <%= link_to "Connect a bank", new_simplefin_access_path, class: "font-medium text-secondary hover:text-primary" %>
        </div>
      </div>
      <div class="h-3 w-px bg-(--border-color-primary) max-sm:hidden"></div>
    <% end %>
    <%= link_to "Skip for now", root_path, class: "font-medium text-secondary hover:text-primary" %>
  </div>
</div>
