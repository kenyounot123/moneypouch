<% peak = line.series.values.max %>
<li class="flex items-center gap-4 py-2">
  <p class="min-w-0 flex-1 truncate">
    <% if line.category %>
      <%= link_to line.label, category_path(line.category, month: month_param(current)), class: "hover:underline" %>
    <% else %>
      <%= line.label %>
    <% end %>
  </p>
  <div class="flex h-7 w-24 shrink-0 items-end gap-0.5 md:w-[220px]" aria-hidden="true">
    <% line.series.each do |period, cents| %>
      <% if cents.positive? %>
        <div class="<%= class_names "flex-1 rounded-bar bg-data", "opacity-50": period.current? %>" style="height: <%= column_height cents, peak, TrendsHelper::SPARKLINE_HEIGHT %>px" title="<%= month_abbreviation period %> · <%= money cents %>"></div>
      <% else %>
        <div class="h-0.5 flex-1 rounded-bar bg-data-track"></div>
      <% end %>
    <% end %>
  </div>
  <div class="w-24 shrink-0 text-right">
    <p class="font-mono"><%= money line.current %></p>
    <% if line.usual&.positive? %>
      <p class="text-xs text-tertiary">usually <%= money line.usual %></p>
    <% end %>
  </div>
</li>
