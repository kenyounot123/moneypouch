<% content_for :title, "Trends" %>
<%= turbo_stream_from Current.user, :transactions %>

<div class="flex min-h-dvh max-md:flex-col">
  <%= render "shared/sidebar" %>

  <main class="flex min-w-0 flex-1 flex-col gap-10 px-5 py-9 md:px-14">
    <h1 class="text-title">Trends</h1>

    <% if @trends.ready? %>
      <div class="flex flex-col gap-12">
        <%= render "trends/glance", trends: @trends %>

        <div class="grid max-w-[960px] grid-cols-1 items-start gap-12 2xl:max-w-none 2xl:gap-x-16 2xl:has-[>div>section]:grid-cols-[minmax(0,3fr)_minmax(0,2fr)]">
          <%= render "trends/categories", trends: @trends %>

          <div class="flex flex-col gap-12 not-has-[section]:hidden">
            <%= render "trends/notes", trends: @trends %>
            <%= render "trends/recurring", trends: @trends %>
            <%= render "trends/income", trends: @trends %>
          </div>
        </div>
      </div>
    <% else %>
      <%= render "trends/empty", trends: @trends %>
    <% end %>
  </main>
</div>
