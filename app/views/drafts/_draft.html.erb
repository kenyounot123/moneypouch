<% shake = local_assigns.fetch(:shake, false) %>
<% typed = draft.line.strip.present? %>
<%= turbo_frame_tag "draft", class: "mx-3 block rounded-b-lg border border-t-0 border-secondary bg-level-1 px-4" do %>
  <% if typed %>
    <div class="flex flex-wrap items-center gap-x-3 gap-y-2 py-3" <%= tag.attributes(data: { inferred_category: (draft.category_name if draft.inferred?) }) %>>
      <div class="flex w-2 shrink-0 justify-center">
        <div class="size-1.5 rounded-[1px] border border-(--background-color-highlight)"></div>
      </div>
      <div class="flex min-w-0 flex-1 basis-44 flex-col gap-1">
        <p class="truncate font-medium">
          <% if draft.name.present? %>
            <%= draft.name %>
          <% else %>
            <%= render "drafts/callout", message: Transaction::Draft::MISSING_NAME, shake: %>
          <% end %>
        </p>
        <p class="text-sm text-tertiary">
          <% if draft.category %>
            <%= draft.category_name %><% if draft.category.new_record? %> <span class="text-xs leading-none">(new)</span><% end %>
          <% else %>
            Uncategorized
          <% end %>
          · <%= relative_date draft.occurred_on %>
        </p>
      </div>
      <p class="ml-auto shrink-0 text-right font-mono">
        <% if draft.amount_in_cents.nil? %>
          <%= render "drafts/callout", message: Transaction::Draft::MISSING_AMOUNT, shake: %>
        <% elsif draft.money_in? %>
          <span class="flex flex-col items-end gap-0.5 text-success">
            <span><%= money draft.amount_in_cents %></span>
            <span class="font-sans text-xs">Money in</span>
          </span>
        <% else %>
          <%= money draft.amount_in_cents %>
        <% end %>
      </p>
    </div>
  <% end %>

  <div class="flex flex-wrap items-center gap-x-5 gap-y-2 py-3 <%= "border-t border-secondary" if typed %>">
    <% [
      [ "5.50", "amount", draft.amount_in_cents.present?, typed && draft.amount_in_cents.nil? ],
      [ "@", "date", draft.dated?, false ],
      [ "#", "category", draft.category_word.present?, false ]
    ].each do |key, label, used, missing| %>
      <span class="inline-flex items-center gap-1.5 whitespace-nowrap <%= used ? "text-primary" : missing ? "text-danger" : "text-tertiary" %>">
        <span class="rounded-sm border px-1.5 py-0.5 font-mono text-xs <%= used ? "border-transparent bg-highlight text-on-action" : missing ? "border-(--text-color-danger)" : "border-primary bg-level-2" %> <%= "animate-shake" if missing && shake %>"><%= key %></span>
        <span class="text-sm"><%= label %><%= " ✓" if used %></span>
      </span>
    <% end %>
  </div>
<% end %>
