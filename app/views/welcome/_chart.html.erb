<div class="flex flex-col gap-5 pt-7" data-controller="chart">
  <% if chart.summary? %>
    <%= render "welcome/summary_chart", period:, chart:, summary:, focus: %>
    <% if focus %>
      <%= render "welcome/focus", summary:, focus: %>
    <% end %>
  <% else %>
    <%= render "welcome/spending_chart", period:, chart:, spending: %>
  <% end %>
</div>
