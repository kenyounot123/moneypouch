<div class="flex flex-col gap-3 pt-7" data-controller="chart">
  <div class="flex items-center justify-between">
    <nav class="flex gap-0.5 rounded-md bg-level-3 p-0.75" aria-label="Chart">
      <% Chart::KINDS.each do |kind| %>
        <% active = kind == chart.kind %>
        <%= link_to kind.capitalize, root_path(period: period.kind, chart: Chart.new(kind)), aria: { current: active ? "true" : nil },
          class: [ "rounded-sm px-2.5 py-1.25 text-sm", active ? "bg-level-2 font-medium text-primary shadow-control" : "text-secondary hover:text-primary" ] %>
      <% end %>
    </nav>
    <div class="text-sm text-tertiary">
      <p data-chart-target="readout"></p>
      <% if chart.summary? %>
        <p class="flex items-center gap-3.5" data-chart-target="key">
          <span class="flex items-center gap-1.5"><span class="size-2 rounded-[2px] bg-data-soft"></span>Income</span>
          <span class="flex items-center gap-1.5"><span class="size-2 rounded-[2px] bg-data"></span>Spent</span>
          <span class="flex items-center gap-1.5"><span class="font-amount text-xs">±</span>Net</span>
        </p>
      <% end %>
    </div>
  </div>

  <% if chart.summary? %>
    <%= render "welcome/summary_chart", period:, summary:, focus: %>
    <% if focus %>
      <%= render "welcome/focus", summary:, focus: %>
    <% end %>
  <% else %>
    <%= render "welcome/spending_chart", period:, spending: %>
  <% end %>
</div>
