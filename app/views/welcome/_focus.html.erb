<% total = summary.total(focus) %>
<% categories = summary.categories(focus).map { |category, cents| [ category&.name || "Uncategorized", cents ] } %>
<% peak = [ total.income, total.spent ].max %>
<div class="flex flex-col gap-4 border-t border-secondary pt-3.5">
  <h3 class="text-md font-semibold"><%= period_name focus %></h3>
  <% if total.income.positive? %>
    <%= render "welcome/flow", label: "Income", amount: total.income, peak:, rows: summary.sources(focus) %>
  <% end %>
  <% if total.spent.nonzero? || categories.any? %>
    <%= render "welcome/flow", label: "Spent", amount: total.spent, peak:, rows: categories %>
  <% end %>
  <% if total.income <= 0 && total.spent.zero? && categories.empty? %>
    <p class="text-sm text-tertiary">Nothing spent.</p>
  <% end %>
</div>
