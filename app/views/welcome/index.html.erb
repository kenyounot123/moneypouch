<%= turbo_stream_from Current.user, :transactions %>

<div class="flex min-h-dvh">
  <%= render "shared/sidebar" %>

  <main class="flex min-w-0 flex-1 flex-col gap-10 px-5 py-9 md:px-14">
    <%= render "shared/composer", voucher: @voucher, added: @added, category_names: @category_names %>

    <%= turbo_frame_tag "spending", class: "flex flex-col gap-10", data: { turbo_action: "advance" } do %>
      <div class="flex flex-col items-start justify-between gap-6 lg:flex-row lg:items-end">
        <div class="flex min-w-0 flex-col gap-2.5">
          <p class="text-secondary"><%= spent_heading(@period) %></p>
          <p class="font-sans text-5xl font-semibold tracking-display sm:text-display"><%= spent @spending.total %></p>
          <div class="flex flex-wrap items-center gap-x-4 gap-y-2 pt-1">
            <div class="flex w-[300px] max-w-full shrink-0 gap-0.5">
              <% @period.columns.each do |column| %>
                <div class="h-2.5 flex-1 rounded-[2px] <%= column <= @period.today ? "bg-highlight" : "bg-data-track" %>"></div>
              <% end %>
            </div>
            <p class="text-sm text-tertiary">Day <%= @period.day %> of <%= @period.days %></p>
            <% if (change = spending_change(@spending)) %>
              <p class="text-sm font-medium text-secondary"><%= change %></p>
            <% end %>
          </div>
        </div>

        <nav class="flex gap-1 rounded-[10px] bg-level-3 p-1" aria-label="Period">
          <% Period::KINDS.each do |kind| %>
            <%= link_to kind.capitalize, root_path(period: kind), aria: { current: kind == @period.kind ? "true" : nil },
              class: [ "rounded-sm px-3 py-1.5 text-sm", kind == @period.kind ? "bg-level-2 font-medium text-primary shadow-control" : "text-secondary hover:text-primary" ] %>
          <% end %>
        </nav>
      </div>

      <div class="flex flex-col gap-14 lg:flex-row">
        <section class="flex min-w-0 flex-[1.3] flex-col gap-[18px]">
          <div class="flex items-baseline justify-between border-b border-secondary pb-3">
            <h2 class="font-pixel text-lg font-semibold tracking-pixel">Where it went</h2>
            <p class="text-sm text-tertiary"><%= span @period.range %></p>
          </div>

          <% categories = @spending.categories %>
          <% categories.each_with_index do |(category, cents), index| %>
            <div class="flex items-center gap-4">
              <p class="w-28 shrink-0 truncate"><%= category&.name || "Uncategorized" %></p>
              <div class="h-2.5 flex-1 rounded-bar bg-data-track">
                <div class="h-full rounded-bar <%= index.zero? ? "bg-data-strong" : "bg-data" %>" style="width: max(3px, round(<%= (cents * 100.0 / categories.first.last).round(1) %>%, 1px))"></div>
              </div>
              <p class="w-22 shrink-0 text-right font-mono"><%= spent cents %></p>
              <p class="w-10 shrink-0 text-right text-sm text-tertiary"><%= share_of cents, @spending.total %></p>
            </div>
          <% end %>
          <% if categories.empty? %>
            <p class="text-sm text-tertiary"><%= nothing_spent @period %></p>
          <% end %>

          <div class="flex flex-col gap-3 pt-[22px]">
            <div class="flex justify-between gap-4">
              <p class="text-sm font-medium text-secondary"><%= @period.unit == :month ? "Monthly" : "Daily" %></p>
              <% if (peak = @spending.peak) %>
                <p class="truncate text-sm text-tertiary"><%= spending_peak peak %></p>
              <% end %>
            </div>
            <% columns = @spending.columns %>
            <% tallest = columns.values.compact.max.to_i %>
            <div class="flex h-16 shrink-0 items-end gap-1">
              <% columns.each do |column, cents| %>
                <% if cents.to_i.positive? %>
                  <div class="flex-1 rounded-bar <%= { @period.column_for(@period.today) => "bg-highlight", columns.key(tallest) => "bg-data-strong" }.fetch(column, "bg-data-soft") %>"
                    style="height: <%= column_height cents, tallest %>px" title="<%= column_title @period, column, cents %>"></div>
                <% else %>
                  <div class="h-1 flex-1 rounded-[2px] <%= column == @period.column_for(@period.today) ? "bg-highlight" : "bg-data-track" %>"></div>
                <% end %>
              <% end %>
            </div>
          </div>
        </section>

        <section class="flex min-w-0 flex-1 flex-col gap-1">
          <div class="flex items-baseline justify-between border-b border-secondary pb-3">
            <h2 class="font-pixel text-lg font-semibold tracking-pixel">Recent</h2>
            <p class="text-sm text-tertiary"><%= recent_count @period_count, @period %></p>
          </div>

          <ul class="flex flex-col gap-1">
            <% @recent.each do |transaction| %>
              <%= render transaction, marked: transaction == @added %>
            <% end %>
            <% if @recent.empty? %>
              <li class="py-3 pl-5 text-sm text-tertiary">No transactions yet. Type one above.</li>
            <% end %>
          </ul>

          <% if @total_count.positive? %>
            <%= link_to transactions_total(@total_count, @since), transactions_path, class: "pt-3 pl-5 text-sm text-tertiary hover:text-secondary", data: { turbo_frame: "_top" } %>
          <% end %>
        </section>
      </div>
    <% end %>
  </main>
</div>
