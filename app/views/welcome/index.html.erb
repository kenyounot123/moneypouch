<%# herb:disable html-aria-role-must-be-valid 1 %>
<%= turbo_stream_from Current.user, :transactions %>

<div class="flex min-h-dvh max-md:flex-col">
  <%= render "shared/sidebar" %>

  <main class="flex min-w-0 flex-1 flex-col gap-10 px-5 py-9 md:px-14">
    <%= turbo_frame_tag "spending", class: "flex flex-col gap-10", data: { turbo_action: "advance" } do %>
      <div class="flex flex-col items-start justify-between gap-6 lg:flex-row lg:items-end">
        <div class="flex min-w-0 flex-col gap-2.5">
          <p class="text-secondary"><%= spent_heading(@period) %></p>
          <p class="text-display"><%= money @spending.total %></p>
          <div class="flex flex-wrap items-center gap-x-4 gap-y-2 pt-1">
            <div class="flex w-[300px] max-w-full shrink-0 gap-0.5" role="meter" aria-label="Days gone"
              aria-valuemin="0" aria-valuemax="<%= @period.days %>" aria-valuenow="<%= @period.day %>">
              <% @period.columns.each do |column| %>
                <div class="h-2.5 flex-1 rounded-[2px] <%= column <= @period.today ? "bg-data" : "bg-data-track" %>"></div>
              <% end %>
            </div>
            <p class="text-sm text-tertiary">Day <%= @period.day %> of <%= @period.days %></p>
          </div>
        </div>

        <nav class="flex gap-1 rounded-[10px] bg-level-3 p-1" aria-label="Period">
          <% Period::KINDS.each do |kind| %>
            <%= link_to kind.capitalize, root_path(period: kind, chart: @chart), aria: { current: kind == @period.kind ? "true" : nil },
              class: [ "rounded-sm px-3 py-1.5 text-sm", kind == @period.kind ? "bg-level-2 text-primary shadow-control" : "text-secondary hover:text-primary" ] %>
          <% end %>
        </nav>
      </div>

      <div class="flex flex-col gap-14 lg:flex-row">
        <section class="flex min-w-0 flex-[1.3] flex-col gap-[18px]">
          <div class="flex items-baseline justify-between border-b border-secondary pb-3">
            <h2 class="text-heading">Where it went</h2>
            <p class="text-sm text-tertiary"><%= span @period.range %></p>
          </div>

          <% categories = @spending.categories %>
          <% categories.each_with_index do |(category, cents), index| %>
            <div class="flex items-center gap-4">
              <p class="w-28 shrink-0 truncate"><%= category&.name || "Uncategorized" %></p>
              <div class="h-2.5 flex-1 rounded-bar bg-data-track">
                <div data-field="category-bar" class="h-full rounded-bar <%= category_color category, index %>" style="width: max(3px, round(<%= (cents * 100.0 / categories.first.last).round(1) %>%, 1px))"></div>
              </div>
              <p class="w-22 shrink-0 text-right font-amount"><%= money cents %></p>
              <p class="w-10 shrink-0 text-right text-sm text-tertiary"><%= share_of cents, categories.sum(&:last) %></p>
            </div>
          <% end %>
          <% if categories.empty? %>
            <p class="text-sm text-tertiary"><%= nothing_spent @period %></p>
          <% end %>

          <%= render "welcome/chart", period: @period, chart: @chart, spending: @spending, summary: @summary, focus: @focus %>
        </section>

        <div class="flex min-w-0 flex-1 flex-col gap-10">
          <% if @review&.pending? %>
            <%= render "simplefin/reviews/block", review: @review, rows: @review_rows, categories: @categories %>
          <% end %>
          <section class="flex min-w-0 flex-col gap-1">
            <div class="flex items-center justify-between border-b border-secondary pb-3">
              <h2 class="text-heading">Recent</h2>
              <div class="flex items-center gap-4">
                <% if @syncing %>
                  <p class="flex items-center gap-1.5 text-sm text-tertiary">
                    <%= icon_tag "spinner", class: "size-3 animate-spin" %>
                    Checking your banks
                  </p>
                <% end %>
                <%= link_to "Show all", transactions_path, class: "text-sm font-medium text-secondary hover:text-primary", data: { turbo_frame: "_top" } %>
              </div>
            </div>

            <ul class="flex flex-col gap-1" data-controller="category-picker" data-category-picker-categories-value="<%= picker_categories @categories %>">
              <%= render @recent, added: @added, review_rows: @review_rows %>
              <% if @recent.empty? %>
                <%= render "welcome/empty_recent" %>
              <% end %>
            </ul>
          </section>
        </div>
      </div>
    <% end %>
  </main>
</div>
