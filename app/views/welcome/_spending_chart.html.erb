<% columns = spending.columns %>
<% today_column = period.column_for(period.today) %>
<% axis = chart_axis(columns.values.compact.max.to_i) %>
<%= render "welcome/chart_header", period:, chart:, readout: column_readout(period, today_column, columns[today_column]) %>
<div class="flex flex-col gap-2">
  <div class="relative shrink-0" style="height: <%= WelcomeHelper::PLOT_HEIGHT %>px">
    <%= render "welcome/axis", axis: %>
    <div class="relative flex h-full items-end gap-1 pr-11">
      <% columns.each do |column, cents| %>
        <% if cents %>
          <div class="group flex h-full flex-1 items-end" data-chart-target="column" <% if column == today_column %>data-active<% end %>
            data-action="mouseenter->chart#show mouseleave->chart#clear" <%= tag.attributes(data: column_readout(period, column, cents).params) %>>
            <% if cents.positive? %>
              <div class="w-full rounded-t-bar bg-data-soft group-data-active:bg-data-strong" style="height: <%= column_height cents, axis.top %>px"></div>
            <% end %>
          </div>
        <% else %>
          <div class="flex-1"></div>
        <% end %>
      <% end %>
    </div>
  </div>
  <div class="flex gap-1 pr-11">
    <% column_labels(period, columns).each do |caption, span| %>
      <p data-field="caption" class="<%= class_names "basis-0 text-xs whitespace-nowrap text-tertiary", "text-center": span == 1 %>" style="flex-grow: <%= span %>"><%= caption %></p>
    <% end %>
  </div>
</div>
