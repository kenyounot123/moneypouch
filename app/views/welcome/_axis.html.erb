<% axis.ticks.each do |cents| %>
  <div class="pointer-events-none absolute right-11 left-0 border-t <%= cents.zero? ? "border-primary" : "border-secondary" %>" data-controller="style" data-style-declarations-value="<%= style_declarations bottom: axis_offset(cents, axis.top) %>"></div>
  <p data-field="tick" class="pointer-events-none absolute right-0 translate-y-1/2 font-amount text-xs text-tertiary" data-controller="style" data-style-declarations-value="<%= style_declarations bottom: axis_offset(cents, axis.top) %>"><%= axis_label cents %></p>
<% end %>
