<div class="flex min-w-0 flex-1 flex-col gap-1.5">
  <h3 class="text-sm font-medium text-secondary"><%= title %></h3>
  <% rows.first(2).each do |name, cents| %>
    <div class="flex justify-between gap-4 text-sm">
      <p class="min-w-0 truncate"><%= name %></p>
      <p class="font-mono"><%= spent cents %></p>
    </div>
  <% end %>
  <% if rows.size > 2 %>
    <div class="flex justify-between gap-4 text-sm text-tertiary">
      <p><%= rows.size - 2 %> more</p>
      <p class="font-mono"><%= spent rows.drop(2).sum(&:last) %></p>
    </div>
  <% end %>
  <% if rows.empty? %>
    <p class="text-sm text-tertiary"><%= empty %></p>
  <% end %>
</div>
