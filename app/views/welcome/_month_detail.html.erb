<% total = summary.total(month) %>
<div class="flex shrink-0 sm:h-[168px] flex-col gap-3.5">
  <div class="flex flex-wrap items-baseline gap-x-2 gap-y-1 sm:gap-x-5">
    <p class="w-full shrink-0 sm:w-21 text-md font-semibold"><%= month.name %></p>
    <div class="flex min-w-0 flex-1 flex-col gap-0.5 sm:flex-none">
      <p class="text-xs text-tertiary">Income</p>
      <p class="font-mono text-md sm:text-lg"><%= spent total.income %></p>
    </div>
    <div class="flex min-w-0 flex-1 flex-col gap-0.5 sm:flex-none">
      <p class="text-xs text-tertiary">Spent</p>
      <p class="font-mono text-md sm:text-lg"><%= spent total.spent %></p>
    </div>
    <div class="flex min-w-0 flex-1 flex-col gap-0.5 sm:flex-none">
      <p class="text-xs text-tertiary">Net</p>
      <p class="font-mono text-md sm:text-lg <%= net_color total.net, positive: "text-success" %>"><%= exact_net total.net %></p>
    </div>
  </div>
  <div class="flex gap-8 border-t border-secondary pt-3">
    <%= render "welcome/ledger", title: "Where it came from", empty: "Nothing came in.", rows: summary.sources(month) %>
    <%= render "welcome/ledger", title: "Where it went", empty: "Nothing spent.",
      rows: summary.categories(month).map { |category, cents| [ category&.name || "Uncategorized", cents ] } %>
  </div>
</div>
