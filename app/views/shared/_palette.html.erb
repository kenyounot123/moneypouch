<%# herb:disable html-no-nested-forms 1 %>
<div class="contents" data-controller="palette" data-palette-composer-outlet="#palette [data-controller=composer]" data-action="keydown@window->palette#shortcut">
  <dialog id="palette" aria-label="Add a transaction" data-palette-target="dialog" data-action="click->palette#dismiss close->palette#clear turbo:before-morph-attribute->palette#keepOpen"
    class="mx-auto mt-4 mb-auto lg:mt-[22vh] w-[calc(100%-2rem)] max-w-[640px] max-h-none overflow-visible border-0 bg-transparent p-0 text-primary rounded-lg shadow-xl backdrop:bg-scrim">
    <%= render "shared/composer", voucher: palette_voucher, category_names: palette_category_names %>
  </dialog>
  <% added = added_transaction %>
  <% if added %>
    <%= render layout: "shared/toast", locals: { id: dom_id(added, :toast) } do %>
      <%= render "shared/pouch", pose: :happy, hopping: true, classes: "absolute -top-[34px] left-3 size-10" %>
      <span class="min-w-0 truncate text-sm">Added <span class="font-medium"><%= added.name %></span> <span class="font-amount"><%= money_flow added.amount_in_cents %></span></span>
      <%= button_to transaction_path(added), method: :delete, form: { class: "shrink-0" }, data: { palette_target: "undo" },
        class: "cursor-pointer rounded-sm px-2 py-1 text-sm font-medium whitespace-nowrap text-secondary hover:bg-level-3 hover:text-primary" do %>
        Undo <span class="rounded-sm border border-primary bg-level-2 px-1.5 py-0.5 font-mono text-xs text-secondary"><%= shortcut("Z") %></span>
      <% end %>
    <% end %>
  <% end %>
</div>
