<div class="relative" data-controller="composer" data-composer-voucher-url-value="<%= voucher_path %>"
  data-composer-categories-value="<%= category_names.to_json %>" data-composer-today-value="<%= Date.current.iso8601 %>"
  data-action="mousemove@window->composer#point turbo:morph@document->composer#sync turbo:frame-render->composer#refresh">
  <%= form_with url: transactions_path, data: { action: "turbo:submit-end->composer#finish" }, class: "flex h-15 shrink-0 items-center gap-3 rounded-lg border border-primary bg-level-2 pr-2 pl-5 shadow-xs focus-within:border-(--ring-color-focus)" do |form| %>
    <svg width="18" height="18" viewBox="0 0 18 18" fill="none" class="shrink-0 stroke-(--background-color-data)" aria-hidden="true">
      <path d="M9 3v12M3 9h12" stroke-width="1.8" stroke-linecap="round" />
    </svg>
    <%= form.hidden_field :idempotency_key, value: SecureRandom.uuid %>
    <%= form.text_field :shorthand, value: voucher.shorthand, placeholder: "coffee 5.50 yesterday", autocomplete: "off", spellcheck: false,
      role: "combobox", aria: { label: "Quick add", autocomplete: "list", expanded: false, controls: "composer-popup" },
      class: "min-w-0 flex-1 bg-transparent text-md outline-none placeholder:text-tertiary",
      data: { composer_target: "field", action: "input->composer#forgetFailure input->composer#refresh keyup->composer#refresh click->composer#refresh focus->composer#refresh blur->composer#refresh keydown->composer#keydown" } %>
    <button class="shrink-0 cursor-pointer rounded-md bg-action px-4 py-2.5 font-pixel text-[15px] leading-[18px] font-semibold whitespace-nowrap tracking-pixel text-on-action hover:brightness-95">Add ↵</button>
  <% end %>
  <%= render "vouchers/voucher", voucher: %>
  <template data-composer-target="failure">
    <div class="border-b border-secondary py-3" data-failure>
      <%= render "vouchers/callout", message: "Not saved. Press Enter to try again.", shake: false %>
    </div>
  </template>
  <div id="composer-popup" hidden class="absolute top-full z-10 mt-1 rounded-md border border-primary bg-level-2 p-1 shadow-control"
    data-composer-target="popup" data-action="mousedown->composer#press"></div>
  <%= render "shared/toast", transaction: added if added %>
</div>
