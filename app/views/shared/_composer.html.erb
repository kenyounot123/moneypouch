<div class="relative rounded-lg border border-primary bg-level-2 shadow-xs focus-within:border-(--ring-color-focus)" data-controller="composer" data-composer-voucher-url-value="<%= voucher_path %>"
  data-composer-categories-value="<%= category_names.to_json %>" data-composer-today-value="<%= Date.current.iso8601 %>"
  data-action="mousemove@window->composer#point turbo:morph@document->composer#sync turbo:frame-render->composer#refresh">
  <%= form_with url: transactions_path, data: { action: "turbo:submit-end->composer#finish" }, class: "flex h-15 shrink-0 items-center gap-3 pr-2 pl-5" do |form| %>
    <%= icon_tag "plus", class: "size-4.5 bg-data" %>
    <%= form.hidden_field :idempotency_key, value: SecureRandom.uuid %>
    <div class="relative flex min-w-0 flex-1 items-center overflow-hidden">
      <div aria-hidden="true" class="pointer-events-none absolute inset-y-0 left-0 flex items-center text-md whitespace-pre text-primary" data-composer-target="mirror"></div>
      <%= form.text_field :shorthand, value: voucher.shorthand, placeholder: "Add a transaction", autocomplete: "off", spellcheck: false,
        role: "combobox", aria: { label: "Add", autocomplete: "list", expanded: false, controls: "composer-popup" },
        class: "relative w-full bg-transparent text-md text-transparent caret-(--text-color-primary) outline-none placeholder:text-tertiary selection:bg-(--ring-color-focus)/30 selection:text-transparent",
        data: { composer_target: "field", action: "input->composer#forgetFailure input->composer#refresh keyup->composer#refresh click->composer#refresh focus->composer#refresh blur->composer#refresh scroll->composer#paintMirror keydown->composer#keydown" } %>
    </div>
    <span class="hidden in-[dialog]:inline-block pointer-coarse:hidden rounded-sm border border-primary bg-level-2 px-1.5 py-0.5 font-mono text-xs text-secondary">esc</span>
    <button class="shrink-0 cursor-pointer rounded-md bg-action px-4 py-2.5 text-button whitespace-nowrap text-on-action hover:brightness-95">Add ↵</button>
  <% end %>
  <%= render "vouchers/voucher", voucher: %>
  <template data-composer-target="failure">
    <div class="pb-3" data-failure>
      <%= render "vouchers/callout", message: "Press Enter to try again.", shake: false %>
    </div>
  </template>
  <div id="composer-popup" hidden class="absolute top-full z-10 mt-1 rounded-md border border-primary bg-level-2 p-1 shadow-control"
    data-composer-target="popup" data-action="mousedown->composer#press"></div>
</div>
