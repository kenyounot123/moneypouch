<div class="relative" data-controller="quick-add" data-quick-add-draft-url-value="<%= draft_path %>"
  data-quick-add-categories-value="<%= category_names.to_json %>" data-quick-add-today-value="<%= Date.current.iso8601 %>"
  data-action="mousemove@window->quick-add#point turbo:morph@document->quick-add#sync turbo:frame-render->quick-add#refresh">
  <%= form_with url: transactions_path, data: { action: "turbo:submit-end->quick-add#finish" }, class: "flex h-15 shrink-0 items-center gap-3 rounded-lg border border-primary bg-level-2 pr-2 pl-5 shadow-xs focus-within:border-(--ring-color-focus)" do |form| %>
    <svg width="18" height="18" viewBox="0 0 18 18" fill="none" class="shrink-0 stroke-(--background-color-data)" aria-hidden="true">
      <path d="M9 3v12M3 9h12" stroke-width="1.8" stroke-linecap="round" />
    </svg>
    <%= form.hidden_field :idempotency_key, value: SecureRandom.uuid %>
    <%= form.text_field :line, value: draft.line, placeholder: "coffee 5.50 yesterday", autocomplete: "off", spellcheck: false,
      role: "combobox", aria: { label: "Quick add", autocomplete: "list", expanded: false, controls: "quick-add-popup" },
      class: "min-w-0 flex-1 bg-transparent text-md outline-none placeholder:text-tertiary",
      data: { quick_add_target: "field", action: "input->quick-add#forgetFailure input->quick-add#refresh keyup->quick-add#refresh click->quick-add#refresh focus->quick-add#refresh blur->quick-add#refresh keydown->quick-add#keydown" } %>
    <button class="shrink-0 cursor-pointer rounded-md bg-action px-4 py-2.5 font-pixel text-[15px] leading-[18px] font-semibold whitespace-nowrap tracking-pixel text-on-action hover:brightness-95">Add ↵</button>
  <% end %>
  <%= render "drafts/draft", draft: %>
  <template data-quick-add-target="failure">
    <div class="border-b border-secondary py-3" data-failure>
      <%= render "drafts/callout", message: "Not saved. Press Enter to try again.", shake: false %>
    </div>
  </template>
  <div id="quick-add-popup" hidden class="absolute top-full z-10 mt-1 rounded-md border border-primary bg-level-2 p-1 shadow-control"
    data-quick-add-target="popup" data-action="mousedown->quick-add#press"></div>
  <%= render "shared/toast", transaction: added if added %>
</div>
