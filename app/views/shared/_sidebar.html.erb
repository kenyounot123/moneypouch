<div data-controller="sidebar" data-action="keydown@window->sidebar#shortcut resize@window->sidebar#closeOnDesktop turbo:before-cache@document->sidebar#close" class="contents">
  <header class="flex items-center gap-2 px-5 pt-7 md:hidden">
    <button type="button" data-sidebar-target="opener" data-action="sidebar#open" aria-label="Show sidebar" aria-haspopup="dialog" class="flex size-7 shrink-0 items-center justify-center rounded-sm text-secondary hover:bg-level-3 hover:text-primary">
      <%= icon_tag "sidebar" %>
    </button>
    <%= render "shared/pouch", blinking: true, classes: "-m-[3px] size-10" %>
    <span class="text-heading font-bold whitespace-nowrap">MoneyPouch</span>
    <button type="button" aria-haspopup="dialog" data-controller="dialog-opener" data-action="dialog-opener#open" data-dialog-opener-id-param="palette"
      class="ml-auto flex cursor-pointer items-center gap-1.5 rounded-md bg-action py-2 pr-3.5 pl-3 text-sm font-medium text-on-action hover:brightness-95">
      <%= icon_tag "plus" %>
      Add
    </button>
  </header>

  <%= render "shared/demo_banner", classes: "mx-5 mt-4 md:hidden" %>

  <dialog aria-label="Sidebar" data-sidebar-target="sheet" data-action="click->sidebar#dismiss turbo:before-morph-attribute->sidebar#keepClosed"
    class="m-0 h-dvh max-h-none w-60 max-w-none border-0 border-r border-secondary bg-level-1 p-0 text-primary backdrop:bg-scrim">
    <div class="flex h-full flex-col justify-between px-5 pt-7 pb-6">
      <%= render layout: "shared/sidebar_panel" do %>
        <button type="button" data-action="sidebar#close" aria-label="Hide sidebar" class="flex size-7 shrink-0 items-center justify-center rounded-sm text-secondary hover:bg-level-3 hover:text-primary">
          <%= icon_tag "sidebar" %>
        </button>
      <% end %>
    </div>
  </dialog>

  <aside id="sidebar" class="sticky top-0 z-10 hidden h-dvh w-sidebar shrink-0 flex-col justify-between border-r border-secondary bg-level-1 px-5 pt-7 pb-6 md:flex in-data-[sidebar=collapsed]:pr-[11px] in-data-[sidebar=collapsed]:pl-3">
    <%= render layout: "shared/sidebar_panel" do %>
      <button type="button" data-sidebar-target="toggle" data-action="sidebar#toggle" aria-label="Toggle sidebar" aria-keyshortcuts="Meta+B Control+B" title="Toggle sidebar (<%= shortcut("B") %>)" aria-controls="sidebar" aria-expanded="<%= sidebar_state == "expanded" %>" class="flex size-7 shrink-0 items-center justify-center rounded-sm text-secondary hover:bg-level-3 hover:text-primary in-data-[sidebar=collapsed]:h-[34px] in-data-[sidebar=collapsed]:w-10">
        <%= icon_tag "sidebar" %>
      </button>
    <% end %>
  </aside>

  <%= render "shared/palette" %>
</div>
