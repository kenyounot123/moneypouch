<div class="flex flex-col gap-8">
  <div class="flex items-center gap-2 pl-1 md:in-data-[sidebar=collapsed]:justify-center md:in-data-[sidebar=collapsed]:pl-0">
    <%= render "shared/pouch", blinking: true, classes: "-m-[3px] size-10 md:in-data-[sidebar=collapsed]:hidden" %>
    <span class="flex-1 text-heading font-bold whitespace-nowrap md:in-data-[sidebar=collapsed]:hidden">MoneyPouch</span>
    <%= yield %>
  </div>

  <button type="button" aria-haspopup="dialog" aria-keyshortcuts="Meta+K Control+K" data-controller="dialog-opener" data-action="dialog-opener#open" data-dialog-opener-id-param="palette"
    class="group sidebar-link -mt-2 cursor-pointer bg-action text-left font-medium whitespace-nowrap text-on-action hover:brightness-95 max-md:hidden md:in-data-[sidebar=collapsed]:self-center">
    <%= icon_tag "plus" %>
    <span class="sidebar-label">Add</span>
    <span class="ml-auto rounded-sm border border-current/25 px-1.5 py-0.5 font-mono text-xs pointer-coarse:hidden md:in-data-[sidebar=collapsed]:hidden"><%= shortcut("K") %></span>
  </button>

  <nav class="flex flex-col gap-0.5 md:in-data-[sidebar=collapsed]:items-center">
    <%= sidebar_link_to "Overview", root_path, icon: :overview %>
    <%= sidebar_link_to "Transactions", transactions_path, icon: :transactions %>
    <%= sidebar_link_to "Categories", categories_path, icon: :categories, active: request.path.start_with?(categories_path) %>
    <%= sidebar_link_to "Trends", trends_path, icon: :trends %>
    <% unless demo? %>
      <%= sidebar_link_to "Import", new_import_path, icon: :import, active: request.path.start_with?(imports_path) %>
    <% end %>
  </nav>
</div>

<%= sidebar_link_to "Settings", settings_path, icon: :settings %>
