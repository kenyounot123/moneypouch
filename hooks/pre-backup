#!/bin/bash
set -euo pipefail

storage=/rails/storage
backups="$storage/backups"

mkdir -p "$backups"

for db in "$storage/${RAILS_ENV:-production}"*.sqlite3; do
  [ -e "$db" ] || continue

  name=$(basename "$db")
  tmp="$backups/$name.tmp"

  rm -f "$tmp"
  sqlite3 "$db" ".backup '$tmp'"
  mv "$tmp" "$backups/$name"
done
