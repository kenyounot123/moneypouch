#!/bin/bash
set -euo pipefail

storage=${STORAGE_DIR:-/rails/storage}
backups="$storage/backups"

[ -d "$backups" ] || exit 0

for snapshot in "$backups"/*.sqlite3; do
  [ -e "$snapshot" ] || continue

  name=$(basename "$snapshot")
  cp "$snapshot" "$storage/$name"
  rm -f "$storage/$name-wal" "$storage/$name-shm"
done
